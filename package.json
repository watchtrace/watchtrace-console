{
  "name": "watchtrace-console",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract": "vitest run src/api/contract.test.ts",
    "test:browser": "playwright test",
    "test:container": "sh scripts/test-container.sh",
    "test:browser:real": "sh scripts/test-browser-real.sh",
    "test:browser:update": "playwright test --update-snapshots",
    "contract:generate": "openapi-typescript openapi/customer-v1.openapi.yaml -o src/api/generated.ts",
    "contract:check": "npm run contract:generate && git diff --exit-code -- src/api/generated.ts",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:contract && npm run build && npm run test:browser"
  },
  "dependencies": {
    "@mantine/core": "9.5.2",
    "@mantine/dates": "9.5.2",
    "@mantine/form": "9.5.2",
    "@mantine/hooks": "9.5.2",
    "@mantine/notifications": "9.5.2",
    "@tabler/icons-react": "3.46.0",
    "@tanstack/react-query": "5.102.3",
    "dayjs": "1.11.23",
    "echarts": "6.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.3.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "jsdom": "29.1.1",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "pg": "8.23.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "yaml": "2.9.0"
  }
}
