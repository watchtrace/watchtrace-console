#!/bin/sh
set -eu
: "${MOCK_CURL_STATE:?Set MOCK_CURL_STATE}"
method=GET; body=; authorization=; url=
while [ "$#" -gt 0 ]; do
  case "$1" in
    --request) method=$2; shift 2 ;;
    --data) body=$2; shift 2 ;;
    --header) case "$2" in Authorization:*) authorization=$2 ;; esac; shift 2 ;;
    https://*) url=$1; shift ;;
    *) shift ;;
  esac
done
[ "$authorization" = "Authorization: Bearer test-token" ] || exit 22
path=${url#https://coolify.example.test/api/v1}
case "$method:$path" in
  GET:/applications/frontend-app)
    jq -cn --arg tag "$(cat "$MOCK_CURL_STATE")" '{uuid:"frontend-app",docker_registry_image_name:"ghcr.io/watchtrace/watchtrace-console",docker_registry_image_tag:$tag}'
    ;;
  PATCH:/applications/frontend-app)
    printf '%s\n' "$(printf '%s' "$body" | jq -er '.docker_registry_image_tag')" > "$MOCK_CURL_STATE"
    printf '{"uuid":"frontend-app"}\n'
    ;;
  POST:/deploy)
    uuid=$(printf '%s' "$body" | jq -er '.uuid')
    jq -cn --arg uuid "$uuid" '{deployments:[{resource_uuid:$uuid,deployment_uuid:("deployment-"+$uuid)}]}'
    ;;
  GET:/deployments/deployment-frontend-app)
    jq -cn --arg tag "$(cat "$MOCK_CURL_STATE")" '{status:"finished",docker_registry_image_tag:$tag}'
    ;;
  *) echo "unexpected mock request: $method $path" >&2; exit 22 ;;
esac
